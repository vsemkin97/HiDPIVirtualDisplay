<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.g9helper.seamlessfullscreen</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/G9 Helper.app/Contents/Resources/g9-seamless-daemon</string>
        <string>--daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/g9_seamless_fullscreen.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/g9_seamless_fullscreen.err</string>
</dict>
</plist>
